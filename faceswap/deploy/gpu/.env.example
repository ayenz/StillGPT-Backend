# Shared secret; the backend sends it as X-API-Key (UPSCALE_GPU_API_KEY there).
FACESWAP_API_KEY=change-me
# Seconds without upscale work before the GPU is released and Immich ML is started again.
UPSCALE_GPU_IDLE_S=150
# onnxruntime CPU threads (pre/post-processing, face detector).
FACESWAP_ORT_THREADS=4
