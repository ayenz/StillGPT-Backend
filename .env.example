# ── required ────────────────────────────────────────────────
PUBLIC_BASE_URL=https://stillgpt.example.com
JWT_SECRET=change-me-to-a-random-64-char-string
POSTGRES_PASSWORD=change-me
# Qoder credentials: a Personal Access Token (pt-…) OR a Service Account key (recommended for production).
# The PAT is a default: admins can replace it from the admin page (PUT /admin/qoder/credential) without a restart.
QODER_PAT=
# QODER_SA_KEY=
# First admin account (created on first start if no admin exists)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# ── optional ────────────────────────────────────────────────
# QODER_ENVIRONMENT_ID=env_…            # reuse an existing Qoder environment (auto-created otherwise)
# Remaining Qoder credits on the admin page: the qoder_session_cookie value from a logged-in qoder.com browser
# (Qoder's usage API rejects PATs). Admins can replace it via PUT /admin/qoder/session.
# QODER_WEB_SESSION=
# CORS_ORIGINS=https://app.example.com,http://localhost:5173  # comma separated, default *
# Passkeys: RP ID defaults to the host of the first https CORS_ORIGINS entry (changing it orphans existing passkeys)
# PASSKEY_RP_ID=app.example.com
# PASSKEY_RP_NAME=StillGPT
# Android app passkeys (both or neither): package + SHA-256 of every signing cert (debug, upload, Play App Signing)
# PASSKEY_ANDROID_PACKAGE=id.example.app
# PASSKEY_ANDROID_CERT_SHA256=AB:CD:...:EF,12:34:...:56
# iOS app passkeys: TEAMID.bundle.id (comma separated)
# PASSKEY_IOS_APP_IDS=ABCDE12345.id.example.app
# DEFAULT_PROFILE_NATIVE=assistant       # chat | assistant
# DEFAULT_PROFILE_COMPAT=chat
# MODEL_ALIASES={"smart":["ultimate","auto"]}
# MODEL_SYNC_INTERVAL_MIN=60
# VIDEO_CONCURRENCY=1   # Qoder accounts get ~1 concurrent video; more just hits Throttling.QueueQuota
# SESSION_BUDGET_CREDITS=5
# Housekeeping defaults (admins can change them via /admin/housekeeping): archive Qoder sessions idle > N hours and
# delete their Qoder files (local copies stay); interval 0 = off
# QODER_RETENTION_HOURS=24
# QODER_HOUSEKEEPING_INTERVAL_HOURS=24
# MEDIA_URL_TTL_SEC=604800
# FFMPEG_PATH=ffmpeg                     # video thumbnails/posters; empty disables (the Docker image ships ffmpeg)
# Folax image provider (folax-adapter sidecar): fast, free, 2 images per prompt, no edits. Disabled when unset.
# FOLAX_URL=http://folax-adapter:8080
# FOLAX_API_KEY=
# FOLAX_CONCURRENCY=8                    # parallel Folax calls; keep <= the adapter's service.max_concurrency
# FOLAX_VIDEO_POLL_MS=15000              # Folax image-to-video status polling (adapter recommends 15 s)
# Web Push for the PWA ("your creation is ready"); off when unset. Generate once: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com   # default: PUBLIC_BASE_URL
# FCM (HTTP v1) for the native Android app; off when unset. base64 of the Firebase service-account JSON:
#   base64 -w0 firebase-service-account.json   (needs project_id, client_email, private_key)
# FCM_SERVICE_ACCOUNT_B64=

# Face swap sidecar (faceswap/, compose service `faceswap`): engines swapper + qoder_crop. Disabled when FACESWAP_URL is unset.
# FACESWAP_URL=http://faceswap:8080
# FACESWAP_API_KEY=                      # same value as the sidecar's FACESWAP_API_KEY; empty = no auth
# FACESWAP_CONCURRENCY=2                 # parallel sidecar calls (CPU bound)
# FACESWAP_TIMEOUT_MS=120000
# FACESWAP_GPU_URL=http://10.121.21.101:8090   # GPU box for /v1/swap (falls back to FACESWAP_URL); usually = UPSCALE_GPU_URL
# FACESWAP_GPU_API_KEY=                  # the GPU sidecar's FACESWAP_API_KEY
# FACESWAP_GPU_TIMEOUT_MS=90000          # per call, incl. waiting behind an upscale on the GPU; past it → CPU fallback
# Upscale (POST /images/:fileId/upscale): GPU box over ZeroTier first, the faceswap sidecar above (CPU) as fallback.
# Available when UPSCALE_GPU_URL or FACESWAP_URL is set.
# UPSCALE_GPU_URL=http://10.121.21.101:8090
# UPSCALE_GPU_API_KEY=                   # the GPU sidecar's FACESWAP_API_KEY; empty = no auth
# UPSCALE_GPU_TIMEOUT_MS=240000          # per call; past it the job falls back to the CPU
# UPSCALE_CPU_TIMEOUT_MS=600000
# AUTO_TITLE=true                         # ChatGPT-style auto chat titles (alias `titler` in MODEL_ALIASES)
# IMAGE_PROVIDER_DEFAULT=auto            # auto (Folax for text-to-image, Qoder fallback) | qoder | folax
# Cloudflare Turnstile on password sign-in (POST /auth/login needs turnstile_token when the secret is set).
# TURNSTILE_SECRET_KEY=
# TURNSTILE_HOSTNAMES=stillgpt.example.com  # widget hostnames; default = hosts of CORS_ORIGINS. No localhost in prod.
# LOG_LEVEL=info
# STILLGPT_HOST_PORT=8790
